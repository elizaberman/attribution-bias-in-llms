# Copy this file to `.env` and fill in the keys for the providers you plan to use.
# All keys are optional — only providers you actually run need to be set.

# Frontier model APIs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Open-weight models via Together AI
TOGETHER_API_KEY=

# Only required to rebuild demographic labels from scratch (Perplexity sonar).
PERPLEXITY_API_KEY=

# Only required to rebuild fame scores from scratch (DataForSEO Google SERP).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Where experiment outputs are written. Defaults to ./results
# ATTRIBENCH_RESULTS=/path/to/results

# Repo root override (rarely needed — defaults to the directory containing this file)
# ATTRIBENCH_ROOT=/path/to/attribution-bias-in-llms
